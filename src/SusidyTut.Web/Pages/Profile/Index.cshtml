@page
@model SusidyTut.Web.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Моя анкета";
}

<h1 class="h3 mb-1">Моя анкета</h1>
<p class="text-muted mb-4">Заповніть анкету, щоб сервіс міг підібрати вам сусідів.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-bold">Про мене</div>
        <div class="card-body">
            <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Name" class="form-control" maxlength="50" />
                        <span asp-validation-for="Input.Name"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Age" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Age" class="form-control" min="16" max="60" />
                        <span asp-validation-for="Input.Age"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Gender)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<Gender>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Input.Gender" value="@v" id="Gender-@v" />
                                    <label class="form-check-label" for="Gender-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Gender"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.PreferredGender)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<PreferredGender>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Input.PreferredGender" value="@v" id="PreferredGender-@v" />
                                    <label class="form-check-label" for="PreferredGender-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.PreferredGender"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.CityId" class="form-label fw-semibold"></label>
                        <select asp-for="Input.CityId" asp-items="Model.CityItems" class="form-select">
                            <option value="">Оберіть місто</option>
                        </select>
                        <span asp-validation-for="Input.CityId"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.University" class="form-label fw-semibold"></label>
                        <input asp-for="Input.University" class="form-control" maxlength="100" />
                        <span asp-validation-for="Input.University"></span>
                    </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-bold">Житло та бюджет</div>
        <div class="card-body">
            <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Housing)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<HousingStatus>())
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Input.Housing" value="@v" id="Housing-@v" />
                                    <label class="form-check-label" for="Housing-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Housing"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.BudgetMin" class="form-label fw-semibold"></label>
                        <input asp-for="Input.BudgetMin" class="form-control" min="1000" max="50000" />
                        <span asp-validation-for="Input.BudgetMin"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.BudgetMax" class="form-label fw-semibold"></label>
                        <input asp-for="Input.BudgetMax" class="form-control" min="1000" max="50000" />
                        <span asp-validation-for="Input.BudgetMax"></span>
                    </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-bold">Побутові звички</div>
        <div class="card-body">
            <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.SleepSchedule)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<SleepSchedule>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.SleepSchedule" value="@v" id="SleepSchedule-@v" />
                                    <label class="form-check-label" for="SleepSchedule-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.SleepSchedule"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Cleanliness)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<Cleanliness>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.Cleanliness" value="@v" id="Cleanliness-@v" />
                                    <label class="form-check-label" for="Cleanliness-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Cleanliness"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Guests)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<GuestsFrequency>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.Guests" value="@v" id="Guests-@v" />
                                    <label class="form-check-label" for="Guests-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Guests"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Noise)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<NoiseTolerance>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.Noise" value="@v" id="Noise-@v" />
                                    <label class="form-check-label" for="Noise-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Noise"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Smoking)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<SmokingAttitude>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.Smoking" value="@v" id="Smoking-@v" />
                                    <label class="form-check-label" for="Smoking-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Smoking"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">@Html.DisplayNameFor(m => m.Input.Pets)</label>
                        <div>
                            @foreach (var v in Enum.GetValues<PetsAttitude>())
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Input.Pets" value="@v" id="Pets-@v" />
                                    <label class="form-check-label" for="Pets-@v">@Format.EnumName(v)</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.Pets"></span>
                    </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-bold">Опис і контакти</div>
        <div class="card-body">
            <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.About" class="form-label fw-semibold"></label>
                        <textarea asp-for="Input.About" class="form-control" rows="4" maxlength="500"></textarea>
                        <span asp-validation-for="Input.About"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Telegram" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Telegram" class="form-control" placeholder="@@nickname" maxlength="33" />
                        <span asp-validation-for="Input.Telegram"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Phone" class="form-control" type="tel" placeholder="+380XXXXXXXXX" maxlength="13" />
                        <span asp-validation-for="Input.Phone"></span>
                    </div>
                    <div class="col-12">
                        <p class="small text-muted mb-2">Контакти бачать лише користувачі, з якими ви підтвердили знайомство.</p>
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsActive" class="form-check-input" role="switch" />
                            <label asp-for="Input.IsActive" class="form-check-label"></label>
                        </div>
                    </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">Зберегти</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
