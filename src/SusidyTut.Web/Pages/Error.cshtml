@page "/Error/{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Message;
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <p class="display-6 text-muted mb-2">@Model.Code</p>
                <h1 class="h3 mb-4">@Model.Message</h1>
                <a class="btn btn-primary" href="@Model.HomeUrl">На головну</a>
            </div>
        </div>
    </div>
</div>
