<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — СусідиТут</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        var isAdmin = User.IsInRole(SusidyTut.Web.Data.DbInitializer.AdminRole);
        var isUser = User.IsInRole(SusidyTut.Web.Data.DbInitializer.UserRole);
        var brandPage = isAdmin ? "/Admin/Index" : isUser ? "/Search/Index" : "/Index";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="@brandPage">
                    <span class="brand-icon">⌂</span> СусідиТут
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (isUser)
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item"><a class="nav-link" asp-page="/Search/Index">Пошук сусідів</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Profile/Index">Моя анкета</a></li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Requests/Index">Запити</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <partial name="_LogoutForm" />
                            </li>
                        </ul>
                    }
                    else if (isAdmin)
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">Адміністрування</a></li>
                            <li class="nav-item ms-lg-2">
                                <partial name="_LogoutForm" />
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="ms-auto d-flex flex-wrap gap-2 py-2 py-lg-0">
                            <a class="btn btn-outline-primary" asp-page="/Account/Login">Увійти</a>
                            <a class="btn btn-primary" asp-page="/Account/Register">Зареєструватися</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white text-muted py-3">
        <div class="container small">&copy; 2026 СусідиТут</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
